{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
    "mcp": {
    "servers": {
      "context7": {
        "type": "local",
        "command": ["npx", "-y", "@upstash/context7-mcp"],
        "disabled": false,
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--browser", "firefox",
          "--headless",
          "--isolated"
        ],
        "disabled": false
      }
    }
  },
  "permissions": [
    // R Language
    { "action": "shell", "resource": "Rscript *", "effect": "deny" },
    { "action": "shell", "resource": "rig *", "effect": "allow" },
    { "action": "shell", "resource": "air *", "effect": "allow" },
    // Git rules
    { "action": "shell", "resource": "git *",           "effect": "deny" },
    { "action": "shell", "resource": "git s *",         "effect": "allow" },
    { "action": "shell", "resource": "git l *",         "effect": "allow" },
    { "action": "shell", "resource": "git diff *",      "effect": "allow" },
    { "action": "shell", "resource": "git show *",      "effect": "allow" },
  ]
}
