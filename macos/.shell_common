# --- 1. SHARED CONFIGURATION ---
[[ -d "$HOME/.local/bin" ]] && . "$HOME/.local/bin/env"

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

# Simplified Quarto Check
[[ -d "/Applications/quarto/bin" ]] && export PATH="/Applications/quarto/bin:$PATH"
[[ -d "$HOME/Applications/quarto/bin" ]] && export PATH="$HOME/Applications/quarto/bin:$PATH"

# --- 2. HELPER: FIND PROJECT ROOT ---
# Searches up for .venv and returns the project directory path
_find_project_root() {
    local check_dir="$PWD"
    while [[ "$check_dir" != "/" && "$check_dir" != "." ]]; do
        [[ -d "$check_dir/.venv" ]] && echo "$check_dir" && return
        check_dir=$(dirname "$check_dir")
    done
}

# --- 3. AUTOMATIC VENV ACTIVATION ---
auto_venv_activation() {
    local project_root=$(_find_project_root)

    if [[ -n "$project_root" ]]; then
        # Activate only if the current python doesn't match the local .venv
        if [[ "$(which python 2>/dev/null)" != "$project_root/.venv/bin/python"* ]]; then
            command -v deactivate >/dev/null 2>&1 && deactivate
            source "$project_root/.venv/bin/activate" >/dev/null 2>&1
        fi
    else
        # Not in a project? Kill any active env
        if command -v deactivate >/dev/null 2>&1; then
            deactivate >/dev/null 2>&1
            unset VIRTUAL_ENV
        fi
    fi
}

# --- 4. THE UNIFIED PROMPT ---
set_custom_prompt() {
    # Git Branch
    local branch="---"
    if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        branch=$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null)
    fi

    # Venv Name
    local project_root=$(_find_project_root)
    local venv_name="---"
    [[ -n "$project_root" ]] && venv_name=$(basename "$project_root")

    # Shell Escapes & Colors
    local s_np="\[" e_np="\]" esc=$'\e'
    [[ -n "$ZSH_VERSION" ]] && s_np="%{" e_np="%}"

    # Prompt Components
    local CYAN="${s_np}${esc}[0;36m${e_np}"
    local MAG="${s_np}${esc}[0;35m${e_np}"
    local GRN="${s_np}${esc}[0;32m${e_np}"
    local YLW="${s_np}${esc}[0;33m${e_np}"
    local WHT="${s_np}${esc}[0;37m${e_np}"
    local RST="${s_np}${esc}[0m${e_np}"

    local user_host="${GRN}\u@\h${RST}"
    local cwd="${YLW}\w${RST}"
    [[ -n "$ZSH_VERSION" ]] && user_host="${GRN}%n@%m${RST}" && cwd="${YLW}%~${RST}"

    PS1="${CYAN}[$branch]${RST} ${MAG}($venv_name)${RST} ${user_host}${WHT}: ${RST}${cwd}${WHT}\$ ${RST}"
}