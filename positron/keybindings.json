[
    // --- MACOS CONFIG ---
    {
        "key": "cmd+enter",
        "command": "notebook.cell.execute",
        "when": "isMac && notebookEditorFocused && notebookCellType == 'code'"
    },
    {
        "key": "cmd+enter",
        "command": "notebook.cell.quitEdit",
        "when": "isMac && notebookEditorFocused && notebookCellType == 'markup' && notebookCellHasOutputs == false"
    },
    {
        "key": "cmd+shift+c",
        "command": "editor.action.commentLine",
        "when": "isMac && editorTextFocus && !editorReadonly"
    },

    // --- WINDOWS CONFIG ---
    {
        "key": "ctrl+enter",
        "command": "notebook.cell.execute",
        "when": "isWindows && notebookEditorFocused && notebookCellType == 'code'"
    },
    {
        "key": "ctrl+enter",
        "command": "notebook.cell.quitEdit",
        "when": "isWindows && notebookEditorFocused && notebookCellType == 'markup' && notebookCellHasOutputs == false"
    },
    {
        "key": "ctrl+shift+c",
        "command": "editor.action.commentLine",
        "when": "isWindows && editorTextFocus && !editorReadonly"
    },
    
    // --- Others ---
    {
        "key": "shift+cmd+c",
        "command": "-workbench.action.terminal.openNativeConsole",
        "when": "!terminalFocus"
    },
    {
        "key": "shift+cmd+c",
        "command": "-positron.variables.copyAsHTML",
        "when": "positronVariablesFocused"
    },
    {
        "key": "shift+cmd+[BracketLeft]",
        "command": "-editor.action.commentLine",
        "when": "editorTextFocus && !editorReadonly"
    }

    // --- New commands ---
]