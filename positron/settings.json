{
	// Styling
	"workbench.colorTheme": "Default Positron Dark",
	"editor.fontFamily": "Fira Code Retina",
	"editor.fontLigatures": true,
	"editor.wordWrap": "on",
	"editor.cursorBlinking": "smooth",
	"editor.rulers": [
		119
	],
	"editor.tabSize": 2,
	"outline.showFunctions": false,
	"files.exclude": {
		"**/.git": false,
		"**/.gitmodules": false
	},

	// Positron
	"terminal.integrated.defaultProfile.windows": "Git Bash",
	"terminal.integrated.defaultProfile.osx": "bash",
	"terminal.integrated.cursorBlinking": true,
	"editor.minimap.enabled": false,
	"positron.notebook.enabled": false,
	"files.associations": {
		"renv.lock": "json"
	},
	"update.mode": "start",
	"diffEditor.ignoreTrimWhitespace": true,
	"positron.quarto.inlineOutput.enabled": true,
	"extensions.allowed": {
		"ms-toolsai.vscode-jupyter-cell-tags": false,
		"ms-toolsai.jupyter-keymap": false,
		"ms-toolsai.vscode-jupyter-slideshow": false,
		"posit.publisher": false,
		"meta.pyrefly": false,
		"GitHub.vscode-pull-request-github": false,
		"*": true
	},

	// Python
	"python.languageServer": "None",
	"python.terminal.activateEnvInCurrentTerminal": false,
	"python.terminal.activateEnvironment": false,
	"[python]": {
		"editor.defaultFormatter": "charliermarsh.ruff",
		"editor.formatOnSave": true,
		"editor.codeActionsOnSave": {
			"source.organizeImports.ruff": "always"
		}
	},
	"notebook.formatOnSave.enabled": true,
	"notebook.cellExecutionTimeVerbosity": "verbose",
	"notebook.defaultFormatter": "charliermarsh.ruff",

	// R
    "[r]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "Posit.air-vscode"
    },
    "[rmd]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "Posit.air-vscode"
    },
    "[quarto]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "quarto.quarto"
    },

	// AI
	"assistant.enabled": true,
	"authentication.openai-compatible.baseUrl": "https://api.deepinfra.com/v1/openai",
	"positron.assistant.models.overrides.customProvider": [
		{
			"name": "DeepSeek V4 Flash",
			"identifier": "deepseek-ai/DeepSeek-V4-Flash-0731"
		}
	],

	// Extensions
	"workbench.iconTheme": "material-icon-theme",
	"github.copilot.enable": {
		"*": false
	},
}