{
	// Styling
	"workbench.colorTheme": "Default Positron Dark",
	"editor.fontFamily": "Fira Code Retina",
	"editor.fontLigatures": true,
	"editor.wordWrap": "on",
	"editor.cursorBlinking": "smooth",
	"editor.rulers": [
		119
	],
	"editor.tabSize": 2,
	"outline.showFunctions": false,
	"files.exclude": {
		"**/.git": false,
		"**/.gitmodules": false
	},

	// Positron
	"terminal.integrated.defaultProfile.windows": "Git Bash",
	"terminal.integrated.defaultProfile.osx": "bash",
	"terminal.integrated.cursorBlinking": true,
	"editor.minimap.enabled": false,
	"positron.notebook.enabled": false,
	"files.associations": {
		"renv.lock": "json"
	},
	"update.mode": "start",
	"diffEditor.ignoreTrimWhitespace": true,

	// Python
	"python.languageServer": "None",
	"python.terminal.activateEnvInCurrentTerminal": false,
	"python.terminal.activateEnvironment": false,
	"[python]": {
		"editor.defaultFormatter": "charliermarsh.ruff",
		"editor.formatOnSave": true,
		"editor.codeActionsOnSave": {
			"source.organizeImports.ruff": "always"
		}
	},
	"notebook.formatOnSave.enabled": true,
	"notebook.cellExecutionTimeVerbosity": "verbose",
	"notebook.defaultFormatter": "charliermarsh.ruff",

	// R
    "[r]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "Posit.air-vscode"
    },
    "[rmd]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "Posit.air-vscode"
    },
    "[quarto]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "quarto.quarto"
    },

	// AI
	"positron.assistant.enable": true,
	"assistant.sidebarView": true,
	"chat.useAgentSkills": true,
	"positron.assistant.aiExcludes": [
		"*.env"
	],
	"github.copilot.enable": {
		"*": false
	},
	
	// Extensions
	"workbench.iconTheme": "material-icon-theme",
	"chat.viewSessions.orientation": "stacked",
}